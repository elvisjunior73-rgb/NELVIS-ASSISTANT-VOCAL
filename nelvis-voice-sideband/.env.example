# Secrets du service — ne jamais versionner ce fichier rempli (.gitignore l'exclut).
# A copier en .env puis a remplir avec les vraies valeurs.

# Cle API OpenAI (projet du trunk Realtime SIP). Reste cote serveur uniquement.
OPENAI_API_KEY=

# Projet OpenAI auquel est rattache le trunk SIP (en-tete OpenAI-Project obligatoire).
OPENAI_PROJECT_ID=

# Secret d'authentification interne entre le webhook Base44 et ce service.
# Genere-le avec : openssl rand -hex 32
SIDEBAND_SECRET=

# Port HTTP d'ecoute du service (10000 par defaut).
PORT=10000